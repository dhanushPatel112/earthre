{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@cloudflare/workers-types"],
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
